# Insight Securities Insights: static single-page app on LiteSpeed/Apache.
# Unknown paths fall back to index.html so deep links (/pharma/company/SEARL) work.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/data/
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change: cache for a year.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Data and the page itself are refreshed whenever a workbook is republished.
  <FilesMatch "\.(json|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
