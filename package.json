{
  "name": "insight-securities-insights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Insights dashboard for Insight Securities: sector and company analytics driven by sector Excel workbooks.",
  "scripts": {
    "data": "tsx scripts/convert/index.ts",
    "dev": "vite",
    "build": "npm run data && tsc -b && vite build && node scripts/postbuild.mjs",
    "build:path": "npm run data && tsc -b && vite build --mode path && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "stress": "python scripts/stress/make_worst_case.py && npm run data"
  },
  "dependencies": {
    "cmdk": "1.1.1",
    "echarts": "6.1.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.6",
    "write-excel-file": "2.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.15.30",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=20"
  }
}
