{
  "$comment": "One entry per sector. To add a sector: put its workbook in data-src/<slug>/, add an entry here with status \"live\", run `npm run data`. Metric ids are the workbook column headers in snake_case (e.g. 'PE TTM' -> pe_ttm). Aggregates/KPIs/league tables reference those ids.",
  "defaultSector": "pharma",
  "sectors": [
    {
      "slug": "pharma",
      "name": "Pharmaceuticals",
      "shortName": "Pharma",
      "status": "live",
      "workbook": "data-src/pharma",
      "description": "PSX-listed pharmaceutical manufacturers: multinationals and local players, June and December fiscal years.",
      "template": "psx-standard",
      "aggregates": [
        {
          "id": "revenue_ttm",
          "label": "Combined revenue",
          "unit": "pkr_mn",
          "type": "sum",
          "metric": "ttm_net_sales"
        },
        {
          "id": "profit_ttm",
          "label": "Combined net profit",
          "unit": "pkr_mn",
          "type": "sum",
          "metric": "ttm_net_profit"
        },
        {
          "id": "revenue_q",
          "label": "Sector revenue (quarter)",
          "unit": "pkr_mn",
          "type": "sum",
          "metric": "net_sales"
        },
        {
          "id": "profit_q",
          "label": "Sector net profit (quarter)",
          "unit": "pkr_mn",
          "type": "sum",
          "metric": "net_profit"
        },
        {
          "id": "revenue_growth_ttm",
          "label": "Revenue growth (TTM)",
          "unit": "pct",
          "type": "ratio_of_sums",
          "num": "ttm_net_sales",
          "den": "prior_ttm_net_sales",
          "minusOne": true
        },
        {
          "id": "profit_growth_ttm",
          "label": "Profit growth (TTM)",
          "unit": "pct",
          "type": "ratio_of_sums",
          "num": "ttm_net_profit",
          "den": "prior_ttm_net_profit",
          "minusOne": true
        },
        {
          "id": "gross_margin_ttm",
          "label": "Gross margin (TTM)",
          "unit": "pct",
          "type": "ratio_of_sums",
          "num": "gross_profit",
          "den": "net_sales",
          "ttm": true
        },
        {
          "id": "operating_margin_ttm",
          "label": "Operating margin (TTM)",
          "unit": "pct",
          "type": "ratio_of_sums",
          "num": "operating_profit",
          "den": "net_sales",
          "ttm": true
        },
        {
          "id": "net_margin_ttm",
          "label": "Net margin (TTM)",
          "unit": "pct",
          "type": "ratio_of_sums",
          "num": "net_profit",
          "den": "net_sales",
          "ttm": true
        },
        {
          "id": "roe_ttm",
          "label": "Sector ROE (TTM)",
          "unit": "pct",
          "type": "ratio_of_sums",
          "num": "ttm_net_profit",
          "den": "total_equity",
          "denAverageLag": 4
        },
        {
          "id": "pe_median",
          "label": "Median P/E (TTM)",
          "unit": "x",
          "type": "median",
          "metric": "pe_ttm",
          "positiveOnly": true
        },
        {
          "id": "pb_median",
          "label": "Median P/B",
          "unit": "x",
          "type": "median",
          "metric": "pb",
          "positiveOnly": true
        },
        {
          "id": "market_cap",
          "label": "Combined market cap",
          "unit": "pkr_mn",
          "type": "sum",
          "metric": "market_cap"
        }
      ],
      "kpis": [
        "revenue_ttm",
        "profit_ttm",
        "revenue_growth_ttm",
